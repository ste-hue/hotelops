%% HotelOps System Architecture
%% Render: https://mermaid.live or VS Code Mermaid extension
%% Last updated: 2026-03-22

flowchart TB
    subgraph SOURCES["🏦 DATA SOURCES"]
        BANKS["Banks<br/>MPS · MPS_KROSS · SELLA<br/>INTESA · BCP"]
        ESOLVER["Esolver ERP<br/>prima nota · schede contabili<br/>partite fornitori · bilancino"]
        PMS["HotelCube PMS<br/>corrispettivi · fatture"]
        MANUAL["Manual XLSX<br/>budget · PF · costi personale"]
    end

    subgraph PIPELINE["⚙️ HOTELOPS REPO"]
        CLASSIFY["ingest/classify.py<br/>10 content detectors<br/>APPEND vs SNAPSHOT"]
        ROUTE["route_file()<br/>canonical rename<br/>copy to datahub"]
        INGEST["12 ingest parsers<br/>Pydantic validation<br/>MD5 dedup"]
        ORCH["orchestrate.py<br/>sync · discover · run"]
        CLI["cli.py — 8 commands<br/>pf · bva · chiudi · saldo<br/>health · previsione · voci · classifica"]
        CONDGES["condges/<br/>Streamlit app<br/>Excel generator"]
    end

    subgraph STORAGE["💾 STORAGE"]
        subgraph DRIVE["Google Drive — hotelops_datahub/"]
            D1["banche/ schede_contabili/<br/>movimenti_contabili/<br/>partite_fornitori/"]
            D2["bilancino/ gasparotto/<br/>piani_finanziari/<br/>accodamenti/ economato/ coperti/"]
        end
        subgraph BQ["BigQuery — hotelops-suite.hotelops"]
            FACTS["12 fact tables"]
            DIMS["7 dimension tables"]
            VIEWS["7 views<br/>⭐ v_previsione_cassa<br/>⭐ v_piano_finanziario_mensile<br/>⭐ v_budget_vs_consuntivo"]
        end
    end

    subgraph KNOWLEDGE["📚 OBSIDIAN VAULT"]
        ONT["ontology/<br/>companies · banks<br/>people · loans · assets"]
        PROC["procedures/<br/>classifica_file<br/>reconcile_banca"]
        STRAT["decisions/ events/<br/>strategia/"]
    end

    subgraph AGENT["📱 NANOCLAW — WhatsApp Agent"]
        WA["WhatsApp Group<br/>Gruppo Panorama"]
        BOT["HotelOps Agent<br/>nanoclaw_hotelops_CLAUDE_v2.md"]
        UPLOADS["/workspace/group/uploads/<br/>file allegati WhatsApp"]
    end

    USERS["👥 Stefano · Rosa · Gasparotto"]

    %% Data flow: Sources → Classify → Route → Drive → Ingest → BQ
    BANKS -->|"Excel CSV<br/>home banking"| CLASSIFY
    ESOLVER -->|"XLS exports"| CLASSIFY
    PMS -->|"TXT pipe-delimited"| CLASSIFY
    MANUAL -->|"XLSX"| CLASSIFY

    CLASSIFY -->|"tipo · società · banca<br/>lifecycle"| ROUTE
    ROUTE -->|"canonical name<br/>correct folder"| DRIVE
    ORCH -->|"discover files<br/>run parsers"| INGEST
    DRIVE --> INGEST
    INGEST -->|"validated rows"| BQ
    FACTS & DIMS --> VIEWS

    %% Agent connections
    WA <--> BOT
    BOT -->|"SQL queries<br/>read-only"| BQ
    BOT -->|"classify --route --ingest<br/>via /workspace/group/uploads/"| CLASSIFY
    BOT <-->|"read entities<br/>write events"| KNOWLEDGE
    UPLOADS --> CLASSIFY

    %% User connections
    USERS --> WA
    USERS -->|"CLI · Streamlit"| CLI
    CLI --> BQ
    CONDGES --> BQ
